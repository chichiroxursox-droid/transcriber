# Only needed for the optional cloud paths
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional overrides. Leave commented to use the code defaults.
# ENGINE=parakeet                # parakeet (local, default) | groq (cloud)
# QUESTION_PROVIDER=claude_cli   # claude_cli (Claude Code subscription) | anthropic (API, default if unset)
# SYSTEM_AUDIO=audiotee          # audiotee (default) | blackhole
# NOISE_GATE=250                 # int16 RMS below which a 1 s chunk is not transcribed
# MIC_DEVICE=                    # sounddevice index or name; system default if unset
# PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v2
# PORT=8737
